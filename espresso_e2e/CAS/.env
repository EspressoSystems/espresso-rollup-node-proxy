# ── Docker images (Nitro v3.9.9) ──────────────────────────────────────────────
NITRO_IMAGE=ghcr.io/espressosystems/nitro-espresso-integration/nitro-node:support-espresso-v3.9.9
ESPRESSO_DEV_NODE_IMAGE=ghcr.io/espressosystems/espresso-sequencer/espresso-dev-node:release-20251120-lip2p-tcp-3855
CAS_IMAGE=ghcr.io/espressosystems/chain-adjacent-service:main-v3_9_9

# Holds the pre-deployed L1 snapshot (l1-state.json) + deployed_chain_info.json.
CONFIG_DIR=generated-config

# ── Network ports ─────────────────────────────────────────────────────────────
ESPRESSO_SEQUENCER_API_PORT=41000
ESPRESSO_DEV_NODE_PORT=20000
ESPRESSO_BUILDER_PORT=41003

# ── Espresso dev-node ─────────────────────────────────────────────────────────
ESPRESSO_SEQUENCER_ETH_MNEMONIC="indoor dish desk flag debris potato excuse depart ticket judge file exit"
ESPRESSO_DEPLOYER_ACCOUNT_INDEX=5
ESPRESSO_DEV_NODE_EPOCH_HEIGHT=1000000

# ── Accounts (well-known dev keys; never use in production) ─────────────────────
# Account 0: batch poster + CAS TEE signer, and the tx-generator value target.
DEPLOYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BATCH_POSTER_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── CAS wiring (poster → CAS over the compose network) ────────────────────────
CAS_FEED_URL=ws://cas:9643
CAS_CALLDATA_RPC_URL=http://cas:8000/cas/arb/calldata
